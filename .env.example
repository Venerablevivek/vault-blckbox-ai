# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
API_PORT=4000

# Public URL of the web UI. Used to build share/invite links.
WEB_URL=http://localhost:3000

# ---- Database ---------------------------------------------------------------
POSTGRES_USER=filesharing
POSTGRES_PASSWORD=filesharing
POSTGRES_DB=filesharing
# Used when running the API outside Docker (npm run dev): point it at localhost:5432.
# Inside Compose the containers build their own URL from POSTGRES_*, so this value is ignored
# there; override the containers with COMPOSE_DATABASE_URL instead.
DATABASE_URL=postgres://filesharing:filesharing@localhost:5432/filesharing
# Password for vault_app, the least-privilege role the API and worker connect as. The migrate
# service (which runs as POSTGRES_USER, the owner) creates the role and sets this password.
APP_DB_PASSWORD=dev-only-app-password
# A direct (not transaction-pooled) connection for LISTEN, advisory locks and migrations. Set it
# when DATABASE_URL goes through PgBouncer. Empty = use DATABASE_URL.
DATABASE_DIRECT_URL=
# Optional read replica for lag-tolerant reads (dashboard, audit trail). Empty = DATABASE_URL.
DATABASE_READ_URL=
DB_POOL_MAX=10
# Per-statement limit for request queries (ms). 0 disables it.
DB_STATEMENT_TIMEOUT_MS=15000
# In Compose: run through PgBouncer with
#   COMPOSE_DATABASE_URL=postgres://filesharing:filesharing@pgbouncer:5432/filesharing
#   COMPOSE_DATABASE_DIRECT_URL=postgres://filesharing:filesharing@postgres:5432/filesharing
#   docker compose --profile pgbouncer up -d

# Addresses allowed to set X-Forwarded-For (comma-separated IPs or CIDRs). Requests from
# anywhere else are identified by their own socket address, so clients cannot spoof their
# IP to dodge rate limits. Compose pins the web container to 10.203.14.10 and sets this.
TRUSTED_PROXIES=127.0.0.1,::1

# ---- Sessions ---------------------------------------------------------------
SESSION_COOKIE_NAME=fs_session
SESSION_TTL_DAYS=7
# Set to true in production (requires HTTPS).
SESSION_COOKIE_SECURE=false

# ---- Object storage (MinIO / S3) --------------------------------------------
# Internal endpoint: how the API reaches MinIO (container-to-container).
S3_ENDPOINT=http://minio:9000
# Public endpoint: what the BROWSER can resolve. Signed URLs are generated against
# this host, because an S3 signature covers the Host header.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=documents
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Limits -----------------------------------------------------------------
# 25 MB, per the assignment blueprint.
MAX_UPLOAD_BYTES=26214400
# Default share-link lifetime (hours). 168 = 7 days.
SHARE_DEFAULT_TTL_HOURS=168
# Invitation lifetime (hours).
INVITE_TTL_HOURS=168
# Lifetime of a presigned download URL (seconds).
SIGNED_URL_TTL_SECONDS=60

# Keys the hash used to count distinct viewers of a share link. Raw IP addresses are
# never stored. Changing this resets viewer counts, which is correct: old hashes stop
# being comparable. Use a long random value in production.
IP_HASH_PEPPER=dev-only-pepper-change-me

# Signs the short-lived cookie that unlocks a password-protected share link in one browser.
# Changing it signs everyone out of protected links. Use a long random value in production.
SHARE_GRANT_SECRET=dev-only-share-grant-secret-change-me

# ---- Uploads, trash and login protection ------------------------------------
# Uploads buffered in memory at once. Worst-case memory = this x MAX_UPLOAD_BYTES.
# Beyond it the API answers 503 with Retry-After.
MAX_CONCURRENT_UPLOADS=4
# Zip downloads: files and bytes per archive, and archives streaming at once per API process.
ARCHIVE_MAX_FILES=1000
ARCHIVE_MAX_BYTES=5368709120
MAX_CONCURRENT_ARCHIVES=4
# Days a deleted document can be restored before it is purged.
TRASH_RETENTION_DAYS=30
# Failed sign-ins for one email address, within the window, before it is locked.
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# How often the cleanup job runs (expired sessions and invitations, old notifications,
# trash past retention). 0 disables it.
MAINTENANCE_INTERVAL_MINUTES=60

# ---- Web ---------------------------------------------------------------------
# Send Strict-Transport-Security. Only enable when the site is served over HTTPS.
ENABLE_HSTS=false

# ---- Email -------------------------------------------------------------------
# SMTP server for invitations, password resets and security notices. Compose runs
# Mailpit, which catches every message: read them at http://localhost:8025.
# In production use your provider, e.g. smtps://user:pass@smtp.example.com:465
# Leave empty to disable sending (the API logs recipient and subject instead).
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Vault <no-reply@vault.local>
# How long a password reset link works.
PASSWORD_RESET_TTL_MINUTES=60
# required: new accounts confirm their address before creating share links or inviting people.
# off: accounts count as verified (only for deployments without email).
EMAIL_VERIFICATION=required

# ---- Malware scanning ---------------------------------------------------------
# clamav: uploads are held until ClamAV scans them; infected files are removed.
# Run with: SCAN_MODE=clamav docker compose --profile antivirus up -d
# off: uploads are marked "not scanned". Production deployments should scan.
SCAN_MODE=off
# Files larger than this are marked "not scanned" (must not exceed clamd's StreamMaxLength).
SCAN_MAX_BYTES=104857600

# ---- Direct uploads, jobs, rate limits and live notifications ------------------
# Largest file the browser may upload straight to storage (bytes; default 5 GB).
MAX_DIRECT_UPLOAD_BYTES=5368709120
UPLOAD_SESSION_TTL_HOURS=24
UPLOAD_PART_URL_TTL_SECONDS=3600
# Months of share-link access history kept (whole monthly partitions are dropped).
SHARE_EVENT_RETENTION_MONTHS=13
# postgres: counters shared by every API instance. memory: per process.
RATE_LIMIT_STORE=postgres
NOTIFICATION_STREAM_HEARTBEAT_SECONDS=15

# ---- Dev conveniences -------------------------------------------------------
# When true, invitation URLs are also returned in the API response, so an owner
# can copy the link without opening the email. Turn off in production.
EXPOSE_INVITE_LINKS=true
# Insert demo users/workspace/documents on boot. Never enable in production.
SEED_DEMO_DATA=true
